# Copy to .env and adjust. All values have local-development defaults.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/salonos
# Long random string in production; tokens are signed with it
JWT_SECRET=change-me
# Comma-separated origins allowed to call the API (the Vite dev server proxies, so this is for deployed frontends)
CLIENT_ORIGIN=http://localhost:5173
# Salons are in India; dates like "today" and opening hours use this zone
TZ=Asia/Kolkata
# Run the live-queue simulation (arrivals, served tokens, booking requests)
SIMULATE=true
# Return OTP codes in the API response until an SMS provider is wired up. Never enable in production.
OTP_DEV_ECHO=true
